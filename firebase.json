{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "hosting": {
"site": "school-bell-manager-v7",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
